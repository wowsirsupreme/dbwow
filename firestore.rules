rules_version = '2';
// DBWOW security rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
//   users/{uid}/...      only the signed-in owner can read or write
//   shares/{shareId}/... anyone can read (share links); only the owner can write
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid == request.auth.uid;
      }
    }

    // anything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
