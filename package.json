{
  "name": "dbwow",
  "version": "0.4.0",
  "private": true,
  "description": "DBWOW - an educational, Access-inspired relational database environment built on real SQLite (sql.js/WebAssembly).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "build:portable": "vite build --config vite.portable.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-wasm.mjs",
    "test:e2e": "npm run build:portable && node tests/e2e/acceptance.cjs tests/e2e/out && node tests/e2e/features.cjs tests/e2e/out && node tests/e2e/learning.cjs tests/e2e/out && node tests/e2e/accounts.cjs tests/e2e/out"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "jspdf": "4.2.1",
    "lucide-react": "0.460.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.12.0",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8"
  }
}
